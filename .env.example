APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# ── Subdomain Portal ──
# Kosongkan untuk dev lokal (routing pakai path / dan /mobile).
# Produksi: isi subdomain, mis. simsdm.nuurulmuttaqiin.or.id & presensi.nuurulmuttaqiin
ADMIN_DOMAIN=
MOBILE_DOMAIN=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Dev boleh pakai debug, produksi wajib warning/error (L1)
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=

# Produksi: SESSION_SECURE_COOKIE=true (HTTPS only)
SESSION_SECURE_COOKIE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
FILESYSTEM_IMAGE_DISK=public
# Produksi: presensi_disk bisa diarahkan ke s3 (MinIO). Lihat reminder.txt.
# FILESYSTEM_PRESENSI_DISK=presensi
QUEUE_CONNECTION=database

# Cache: file (default aman, tanpa infra). Produksi ramai: ganti ke redis (L2/P1)
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Produksi: ganti MAIL_MAILER=smtp + isi kredensial (Brevo, Mailgun, dll)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Broadcasting (Reverb) ──
# Produksi: jalankan php artisan reverb:start via supervisor
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=app-id
REVERB_APP_KEY=app-key
REVERB_APP_SECRET=app-secret
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=http

# ── Sentry (Error Monitoring) ──
# https://sentry.io/signup/ — gratis tier cukup utk yayasan
SENTRY_LARAVEL_DSN=
SENTRY_LARAVEL_TRACES_SAMPLE_RATE=0.1

# ── Web Push (PWA) ──
# Generate via: php artisan webpush:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Integrasi app keuangan (data siswa per kelas)
# Base URL app keuangan (Next.js). Samakan dengan INTERNAL_API_KEY di .env keuangan.
KEUANGAN_API_URL=http://localhost:3000
KEUANGAN_API_KEY=change-me-in-production

# Password akun hasil seeding demo. Ganti sebelum seeding production.
SEED_DEFAULT_PASSWORD=password

# Profil Yayasan (kop surat PDF)
YAYASAN_NAME="YAYASAN PENDIDIKAN NUURUL MUTTAQIIN"
YAYASAN_TAGLINE="Sistem Informasi Manajemen SDM & Presensi"
YAYASAN_ADDRESS="Jl. Pendidikan No. 1, Kota - Provinsi"
YAYASAN_PHONE="(021) 0000-0000"
YAYASAN_EMAIL="info@nuurulmuttaqiin.or.id"
YAYASAN_WEBSITE="www.nuurulmuttaqiin.or.id"
